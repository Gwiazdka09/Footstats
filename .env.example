# ============================================================
# FootStats v3.4 — Szablon zmiennych środowiskowych
# Skopiuj do .env i uzupełnij prawdziwymi wartościami.
# NIGDY nie commituj .env do repozytorium!
#
# Ten plik jest JEDYNYM źródłem prawdy o konfiguracji. Zsynchronizowany z kodem
# 2026-07-29 audytem (skan `os.getenv`/`os.environ` w src/ i scripts/, z rozwiązaniem
# stałych typu ENV_BZZOIRO). Powód: serwis Cloud Run przez 9 dni nie miał
# BZZOIRO_KEY i draft cicho zwracał ok:False — nikt nie wiedział, że ta zmienna
# jest wymagana, bo nie było jej tutaj.
#
# Dopisując odczyt env w kodzie — dopisz zmienną TUTAJ.
# ============================================================

# ============================================================
# BAZA DANYCH
# ============================================================
# PRODUKCJA. Od 2026-07-29 wskazuje Supabase (session pooler); wcześniej wskazywał
# Neona, przez co narzędzia lokalne trafiały w martwą bazę.
# UWAGA: pytest PRZERYWA sesję, gdy ta zmienna wskazuje prod (tests/conftest.py).
#   suita unit:  DATABASE_URL="" pytest tests/
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Cel backfillu (ten sam URL co wyżej). Osobno, bo skrypt potrzebuje jawnego celu.
DATABASE_URL_SUPABASE=postgresql://user:password@host/dbname?sslmode=require

# Stary Neon — TYLKO źródło backfillu po resecie quota (~1.08), nigdy jako prod.
# scripts/backfill_users_from_neon.py przerywa, gdy źródło == cel.
DATABASE_URL_NEON=postgresql://user:password@host/dbname?sslmode=require

# ============================================================
# KLUCZE API — ŹRÓDŁA DANYCH
# ============================================================
# football-data.org (OBOWIĄZKOWY wg SourceManager) — https://www.football-data.org/client/register
FOOTBALL_API_KEY=your_football_data_org_key

# api-sports.io — kursy, HT, składy. Budżet 100 req/dzień na darmowym planie.
# Potrzebny też fallbackowi fixtures (scrapers/fixtures_fallback.py).
APISPORTS_KEY=your_apisports_key

# sports.bzzoiro.com — ŹRÓDŁO GŁÓWNE draftu (mecze + predykcje ML + kursy).
# Bez niego /cron/draft schodzi na fallback API-Football.
BZZOIRO_KEY=your_bzzoiro_key

# The Odds API (opcjonalny, 3. ogniwo łańcucha kursów) — https://the-odds-api.com/
# Requests-only, bez anti-bota, cała liga w 1 zapytaniu. Darmowo 500 kredytów/mc
# (koszt = rynki × regiony, u nas h2h+totals × eu = 2/ligę).
ODDS_API_KEY=your_the_odds_api_key

# TheSportsDB (opcjonalny) — pokrycie reprezentacji/turniejów, których ligowe
# źródła gubią. Bez klucza działa klucz publiczny o niższym limicie.
THESPORTSDB_KEY=

# Ile meczów maksymalnie dopytać o kursy przy fallbacku fixtures.
# 1 mecz = 2 zapytania AF przy dziennym limicie 100 — dlatego limit jest twardy.
FALLBACK_ODDS_LIMIT=15

# ============================================================
# LLM
# ============================================================
# Groq (obowiązkowy dla warstwy AI) — https://console.groq.com/
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant

# Lokalny model jako alternatywa dla Groq (ai/client.py)
AI_PREFER_LOCAL=0
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
AI_TPM_LIMIT=
AI_REASONING_FACTOR=

# ============================================================
# FLAGI MODELU — sterują tym, CO REALNIE GRA NA ŻYWO
# Zmiana którejkolwiek jest model-critical: wymaga walk-forward i świadomej decyzji.
# ============================================================
# Dixon-Coles w produkcji (default ON) + waga ramienia bayesowskiego
USE_DIXON_COLES=1
W_BAYESIAN=0.5

# Korekta tau Dixona-Colesa dla niskich wynikow (0-0, 1-0, 0-1, 1-1).
# DOMYSLNIE WYLACZONA. Zmierzona 09.08.2026 walk-forwardem na 600 meczach:
# poprawia Brier o grosze, psuje log-loss, a rho doprowadzajace sredni remis
# do realnych 25% obniza trafnosc. Model zaniza remisy z braku ROZDZIELCZOSCI,
# nie z powodu zaleznosci niskich wynikow — tau tego nie naprawia.
# Wlaczac dopiero, gdy model zyska realna rozdzielczosc. Szczegoly: config.py.
USE_DC_TAU=0
DC_RHO=-0.13

# Waga rynku w ensemble. 0.70 = 30% model / 70% rynek (LIVE od 06-26).
ENSEMBLE_MARKET_WEIGHT=0.70

# Escape-hatch Poissona. "0" wymusza bzzoiro-ml NAWET gdy parquet jest w obrazie.
# Ustawione na 0 na serwisie 2026-07-29, żeby deploy z parquetem był neutralny —
# zdjęcie tej flagi to flip P0/A.
QUICK_PICKS_USE_POISSON_CACHE=1

# Kalibracja prawdopodobieństw (OFF — zdegenerowana krzywa psuła Kelly/value-bet).
# Włączyć dopiero po ~88 świeżych settled (D2 auto-refit).
CALIBRATION_ENABLED=0

# M1 lewary — ZBUDOWANE, WYŁĄCZONE, czekają na walidację
SELECTION_MIN_CONF=
LEAGUE_GATING=0
SCHEDULE_ADJUSTED_RATINGS=0
LIGA_WHITELIST_ENFORCE=1

# Override tipu przez model (Cel B bug 2)
GROQ_TIP_OVERRIDE=0
GROQ_TIP_OVERRIDE_2WAY=0
GROQ_TIP_OVERRIDE_THRESHOLD=

# ============================================================
# BEZPIECZEŃSTWO / AUTH
# ============================================================
# Wygeneruj: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_jwt_secret_min_32_chars

# Konto administratora (fallback logowania gdy DB niedostępna)
FOOTSTATS_USER=admin
FOOTSTATS_PASSWORD_HASH=bcrypt_hash_hasla

# Shared secret endpointów /cron/* wołanych przez Cloud Scheduler.
CRON_SECRET=your_cron_shared_secret

# Token chroniący /metrics (bez niego endpoint zwraca 401).
METRICS_TOKEN=your_metrics_token

# CORS — URL frontendu
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Baza URL frontendu w linkach mailowych (reset hasła). Bez tego reset nie działa.
FRONTEND_URL=http://localhost:5173

# ============================================================
# EMAIL (Resend)
# ============================================================
# mailer.py czyta OBIE pisownie. Kanoniczna jest WIELKIMI literami; wariant małymi
# to alias wsteczny (tak stoi w istniejącym .env) — nie usuwać bez migracji klucza.
RESEND_API_KEY=your_resend_key
# resend_api_key=your_resend_key
RESEND_FROM=onboarding@resend.dev

# ============================================================
# TELEGRAM (opcjonalny)
# ============================================================
# Utwórz bota: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
TELEGRAM_BOT_USERNAME=your_bot_username

# ============================================================
# SCRAPER LOGINY (Playwright — tylko lokalnie, nie w cloud draft)
# ============================================================
STS_LOGIN=your_email@example.com
STS_HASLO=your_sts_password
SUPERBET_LOGIN=your_email@example.com
SUPERBET_PASSWORD=your_superbet_password

# ============================================================
# OBSERWOWALNOŚĆ (opcjonalne)
# ============================================================
SENTRY_DSN=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=

# ============================================================
# BANKROLL / OPERATOR
# ============================================================
WEEKLY_DRAWDOWN_PCT=10
OPERATOR_ADMIN_USERNAME=admin
OPERATOR_SMOKE_TIMEOUT=
OPERATOR_STAWKA_A=
OPERATOR_STAWKA_B=

# Smoke-testy API operatora
SMOKE_JWT_SECRET=
SMOKE_TEST_PASS=
FOOTSTATS_PASSWORD=

# ============================================================
# ŚRODOWISKO / PRZEŁĄCZNIKI
# ============================================================
# "production" wyłącza /docs, /openapi i montowanie /mcp
ENV=development

# Tryb demo API (zwraca dane przykładowe zamiast prawdziwych)
DEMO_MODE=0

# Odblokowuje lokalne uruchomienie LIVE pipeline (guard scripts/hooks/guard_live_ops.py)
FOOTSTATS_ALLOW_LIVE=0

# Odświeżanie bazy zawodników w fazie final
FOOTSTATS_REFRESH_PLAYERS=0

# Świadome obejście guardu prod-DB w testach — TYLKO diagnostyka
# FOOTSTATS_ALLOW_PROD_DB=1

# ============================================================
# USUNIĘTE 2026-07-29 (audyt) — nie przywracać bez konsumenta w kodzie:
#   GOOGLE_API_KEY   — zero odczytów w src/ i scripts/
#   SECRET_KEY       — wymagany przez preflight/sanity_check i ustawiany w CI,
#                      ale ŻADEN kod produkcyjny go nie czyta (fałszywe poczucie
#                      bezpieczeństwa). Usunąć też ze skryptów i Secret Managera.
#   LOG_LEVEL        — w kodzie to stała w utils/logging.py, nie zmienna env
#   UPTIMEROBOT_API_KEY — zero odczytów
#   NEXT_PUBLIC_SUPABASE_URL / _PUBLISHABLE_KEY — pozostałość po Next.js,
#                      GUI jest na Vite (VITE_/import.meta.env)
# ============================================================
