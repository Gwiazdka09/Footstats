# ============================================================
# FootStats v3.4 — Szablon zmiennych środowiskowych
# Skopiuj do .env i uzupełnij prawdziwymi wartościami.
# NIGDY nie commituj .env do repozytorium!
#
# Ten plik jest JEDYNYM źródłem prawdy o konfiguracji. Zsynchronizowany z kodem
# 2026-07-29 audytem (skan `os.getenv`/`os.environ` w src/ i scripts/, z rozwiązaniem
# stałych typu ENV_BZZOIRO). Powód: serwis Cloud Run przez 9 dni nie miał
# BZZOIRO_KEY i draft cicho zwracał ok:False — nikt nie wiedział, że ta zmienna
# jest wymagana, bo nie było jej tutaj.
#
# Dopisując odczyt env w kodzie — dopisz zmienną TUTAJ.
# ============================================================

# ============================================================
# BAZA DANYCH
# ============================================================
# PRODUKCJA. Od 2026-07-29 wskazuje Supabase (session pooler); wcześniej wskazywał
# Neona, przez co narzędzia lokalne trafiały w martwą bazę.
# UWAGA: pytest PRZERYWA sesję, gdy ta zmienna wskazuje prod (tests/conftest.py).
#   suita unit:  DATABASE_URL="" pytest tests/
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Cel backfillu (ten sam URL co wyżej). Osobno, bo skrypt potrzebuje jawnego celu.
DATABASE_URL_SUPABASE=postgresql://user:password@host/dbname?sslmode=require

# Stary Neon — TYLKO źródło backfillu po resecie quota (~1.08), nigdy jako prod.
# scripts/backfill_users_from_neon.py przerywa, gdy źródło == cel.
DATABASE_URL_NEON=postgresql://user:password@host/dbname?sslmode=require

# ============================================================
# KLUCZE API — ŹRÓDŁA DANYCH
# ============================================================
# football-data.org (OBOWIĄZKOWY wg SourceManager) — https://www.football-data.org/client/register
FOOTBALL_API_KEY=your_football_data_org_key

# api-sports.io — kursy, HT, składy. Budżet 100 req/dzień na darmowym planie.
# Potrzebny też fallbackowi fixtures (scrapers/fixtures_fallback.py).
APISPORTS_KEY=your_apisports_key

# sports.bzzoiro.com — ŹRÓDŁO GŁÓWNE draftu (mecze + predykcje ML + kursy).
# Bez niego /cron/draft schodzi na fallback API-Football.
BZZOIRO_KEY=your_bzzoiro_key

# The Odds API (opcjonalny, 3. ogniwo łańcucha kursów) — https://the-odds-api.com/
# Requests-only, bez anti-bota, cała liga w 1 zapytaniu. Darmowo 500 kredytów/mc
# (koszt = rynki × regiony, u nas h2h+totals × eu = 2/ligę).
ODDS_API_KEY=your_the_odds_api_key

# TheSportsDB (opcjonalny) — pokrycie reprezentacji/turniejów, których ligowe
# źródła gubią. Bez klucza działa klucz publiczny o niższym limicie.
THESPORTSDB_KEY=

# Ile meczów maksymalnie dopytać o kursy przy fallbacku fixtures.
# 1 mecz = 2 zapytania AF przy dziennym limicie 100 — dlatego limit jest twardy.
FALLBACK_ODDS_LIMIT=15

# Ile dni wstecz/wprzod API-Football w ogole odpowiada. Darmowy plan wpuszcza
# wylacznie okno `dzis +/-1 dzien` i na wszystko poza nim zwraca odmowe
# ("Free plans do not have access to this date"). Zapytanie o starsza date to
# wydany request bez szans na odpowiedz — dlatego go nie wysylamy.
# Platny plan nie ma tego ograniczenia: wtedy rozsun prog (np. 3650).
AF_HORYZONT_DNI=1

# ============================================================
# LLM
# ============================================================
# Groq (obowiązkowy dla warstwy AI) — https://console.groq.com/
GROQ_API_KEY=your_groq_api_key
# UWAGA: nazwa modelu MUSI byc ustawiona jawnie takze w Cloud Run Jobs.
# 16-22.08.2026 Groq wycofal `llama-3.1-8b-instant` — nazwa zyla wylacznie jako
# wartosc domyslna w kodzie, joby nie mialy `GROQ_MODEL`, wiec potok stal 6 dni
# na bledzie 404 przy `exit=0`. `gpt-oss` wymaga `reasoning_effort=low`.
GROQ_MODEL=openai/gpt-oss-120b

# Lokalny model jako alternatywa dla Groq (ai/client.py)
AI_PREFER_LOCAL=0
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
AI_TPM_LIMIT=
AI_REASONING_FACTOR=

# ============================================================
# FLAGI MODELU — sterują tym, CO REALNIE GRA NA ŻYWO
# Zmiana którejkolwiek jest model-critical: wymaga walk-forward i świadomej decyzji.
# ============================================================
# Dixon-Coles w produkcji (default ON) + waga ramienia bayesowskiego
USE_DIXON_COLES=1
W_BAYESIAN=0.5

# Sila druzyny liczona wobec LIGI zamiast wobec wlasnej probki. DOMYSLNIE ON.
# Wczesniej lambda brala 15 ostatnich meczow TEJ PARY i dzielila gole przez
# srednia z tej samej pietnastki — druzyna duzo strzelajaca dzielila wiec swoje
# gole przez srednia, ktora sama zawyzyla, i sygnal sie kasowal. To bylo zrodlo
# braku rozdzielczosci modelu.
# Zmierzone walk-forwardem na dwoch niezaleznych probach (09.08.2026):
#   Brier 0.6557->0.6089 (4 ligi top), 0.6639->0.6142 (6 innych lig),
#   end-to-end 0.6454->0.6064; trafnosc Bundesligi 50.0%->52.7% (rynek 54.7%).
# SILA_LIGOWA=0 wraca do starej lambdy bez redeploya.
SILA_LIGOWA=1

# Korekta tau Dixona-Colesa dla niskich wynikow (0-0, 1-0, 0-1, 1-1).
# DOMYSLNIE WYLACZONA. Zmierzona 09.08.2026 walk-forwardem na 600 meczach:
# poprawia Brier o grosze, psuje log-loss, a rho doprowadzajace sredni remis
# do realnych 25% obniza trafnosc. Model zaniza remisy z braku ROZDZIELCZOSCI,
# nie z powodu zaleznosci niskich wynikow — tau tego nie naprawia.
# Wlaczac dopiero, gdy model zyska realna rozdzielczosc. Szczegoly: config.py.
USE_DC_TAU=0
DC_RHO=-0.13

# Ile znakow przypada na token przy szacowaniu rozmiaru promptu.
# ZMIERZONE na realnym promptcie 09.08.2026: Groq naliczyl 8957 tokenow przy
# tekscie, ktory po 3 znaki/token wychodzil na 4300 — realny stosunek to ~1.4.
# Powod: polskie diakrytyki, geste liczby i emoji w opisach meczow. Za wysoka
# wartosc = prompt idzie nieprzyciety i job pada na 413.
AI_ZNAKOW_NA_TOKEN=1.4

# Waga strzalow celnych w liczeniu sily druzyny (0 = same gole, stan sprzed 13.08).
# Gol pada ~1.4 raza na druzyne, strzal celny 4-5x czesciej — ta sama probka daje
# wiec stabilniejsza ocene sily. ZMIERZONE na dwoch niezaleznych probach:
#   Brier 0.6062->0.6032 (4 ligi top), 0.6290->0.6180 (6 innych lig).
# 0.7 jest bliskie optimum na obu; czyste strzaly (1.0) byly gorsze na czolowych.
# Brak kolumn hst/ast cicho wraca do goli — polowa datasetu ich nie ma.
WAGA_STRZALOW=0.7

# Waga rynku w ensemble. 0.70 = 30% model / 70% rynek.
# LIVE na API od 06-26; na JOBACH dopiero od 14.08.2026 — do tego dnia joby
# chodzily na defaultcie 70/30 (ku modelowi), czyli ten sam mecz dawal INNA
# predykcje zaleznie od sciezki. Rozjazd zlikwidowany po przeliczeniu A/B
# na modelu PO poprawkach z 13.08 (strzaly celne + sila ligowa), n=3578,
# trzy niezalezne grupy lig:
#
#   model/rynek   trafnosc   Brier    log-loss   ROI (flat, EV>5%, podatek 12%)
#     100/0        50.7%     0.5971   0.9994     -19.9%
#      70/30       51.6%     0.5897   0.9884     -21.1%
#      30/70       52.5%     0.5836   0.9795     -22.6%
#       0/100      52.6%     0.5820   0.9768        — (brak zakladow)
#
# TWARDE USTALENIE: gdy argmax modelu != argmax rynku (510 meczow), rynek trafia
# 42.9%, model 29.8% — spojnie na wszystkich trzech grupach. ROI ujemne przy
# KAZDEJ wadze. Model nie znajduje value w 1X2; jego glos zostawiony na 30%,
# bo grupa kontrolna ma szczyt trafnosci wlasnie tam, a zejscie do 0/100
# oznaczaloby wypisanie modelu z typowania 1X2 (decyzja produktowa, nie parametr).
# Nie badane: Over/Under i BTTS — tam model moze nadal wnosic wartosc.
ENSEMBLE_MARKET_WEIGHT=0.70

# ── Nadrabianie zaleglych rozliczen (14.08.2026) ────────────────────────────
# `update_pending` filtrowalo mecze oknem domknietym z OBU stron, wiec predykcja
# ktorej wynik nie pojawil sie w swoje `days_back` dni wypadala z zasiegu NA ZAWSZE.
# Produkcja: 95 predykcji bez wyniku, mecze od 7 maja; z tego 13 dalo sie jeszcze
# odzyskac, 82 przepadly. Teraz zaleglosci wracaja do kolejki paczkami.
#
# Ile zaleglych meczow na jeden przebieg (poza swiezym oknem, ktore idzie w calosci).
LIMIT_NADRABIANIA=15
# Po ilu nieudanych probach rekord uznajemy za nieodzyskiwalny i przestajemy pytac.
# Bez tego 82 martwe rekordy skanowalyby sie w kolko, zjadajac budzet requestow.
MAX_PROB_ROZLICZENIA=5

# Escape-hatch Poissona. "0" wymusza bzzoiro-ml NAWET gdy parquet jest w obrazie.
# Ustawione na 0 na serwisie 2026-07-29, żeby deploy z parquetem był neutralny —
# zdjęcie tej flagi to flip P0/A.
QUICK_PICKS_USE_POISSON_CACHE=1

# Kalibracja prawdopodobieństw (OFF — zdegenerowana krzywa psuła Kelly/value-bet).
# Włączyć dopiero po ~88 świeżych settled (D2 auto-refit).
CALIBRATION_ENABLED=0

# Próg kandydata dla daily_agent / cloud_draft — SKALA PROCENTOWA (0-100).
# Do 2026-08-24 stała w kodzie wynosiła 0.55 i szła do porównania z procentami,
# czyli znaczyła 0,55% — filtr nie odrzucał niczego, a panel pokazywał „55.0".
# Uwaga: nawet przy 50 to szerokie sito — `_typy_pewne` liczy też 1X/X2/12, a suma
# trzech par podwójnej szansy to zawsze 200%, więc któraś zawsze przejdzie.
# Bramą kuponu jest SELECTION_MIN_CONF poniżej, nie ta wartość.
AGENT_KANDYDAT_PROG=50

# D5 — dziennik kuponów sięga po wyniki do źródeł zewnętrznych, gdy nie mamy
# własnej predykcji dla meczu. Bez tego kupon na mecz spoza naszych typów zostaje
# ACTIVE na zawsze: zmierzone 24.08 na sześciu kuponach dziennika — predykcję ma
# 1 noga z 12, a rozliczanie jest all-legs-or-nothing.
# Kosztuje zapytania do API-Football/football-data z limitowanego planu, dlatego
# domyślnie 0. Nasze dane zachowują pierwszeństwo także przy 1.
MANUAL_SETTLE_EXTERNAL=0

# M1 lewary — ZBUDOWANE, WYŁĄCZONE, czekają na walidację
SELECTION_MIN_CONF=
LEAGUE_GATING=0
SCHEDULE_ADJUSTED_RATINGS=0
LIGA_WHITELIST_ENFORCE=1

# M5 — wyrzuca BTTS z puli selekcji `najlepszy_typ`. 0 = zero zmiany prod.
# ZA: walk-forward n=15 460 daje model BTTS 53,2% przy częstości bazowej 54,4%
# (Brier 0,2496 vs 0,2480) — „zawsze BTTS tak" bije model, więc sygnału tam nie ma,
# a argmax i tak wybiera rynki 2-way w 74% meczów (struktura reguły, nie przewaga).
# PRZECIW FLIPOWI DZIŚ: na produkcji BTTS ma n=13 (ROI −51,9%, bez BTTS +2,9% wobec
# −2,0% ogółem) — jeden zakład przesuwa ROI o 14,5 pp, a po korekcie na wybór
# najgorszego z czterech rynków p=0,111. Flip po uzbieraniu próbki.
SELECTION_SKIP_BTTS=0

# Override tipu przez model (Cel B bug 2)
GROQ_TIP_OVERRIDE=0
GROQ_TIP_OVERRIDE_2WAY=0
GROQ_TIP_OVERRIDE_THRESHOLD=

# Czy typ "BTTS NIE" moze wejsc do kuponu (0 = liczony i logowany, ale nie gra).
# Zmierzone 15.08, walk-forward n=15460, proba dzielona po dacie:
#   * sygnal `p_btts` JEST realny — krzywa monotoniczna w OBU polowach proby:
#     p_btts 0-40% → BTTS pada w 48.7%/51.2%;  p_btts 65%+ → 60.7%/64.1%
#   * gra dwustronna (margines 15pp) bije stala odpowiedz: TAK +7.0/+8.4pp, NIE +6.3/+6.6pp
#   * ALE przeciw rynkowi przegrywa: Brier 0.2524/0.2508 vs rynek 0.2503/0.2460,
#     przy niezgodzie rynek 52.2%/53.0% vs model 47.8%/47.0%
#   * arytmetyka progu: NIE trafia 50.8% → wymaga kursu 2.10, rynek daje ~1.6
# Flip dopiero po zebraniu realnych kursow `btts_no` i zmierzeniu ROI na nich.
BTTS_TWO_WAY=0

# A1: czy typy maja powstawac z modelu, gdy warstwa LLM nic nie zwrocila.
# Default 1 (wlaczone). Poisson/ensemble liczy typ bez udzialu Groqa, ale do
# 08.2026 pusta lub niesparsowana odpowiedz kasowala CALY dzien predykcji.
# Wiersze z tej sciezki maja `kupon_type='model'` i `prompt_version='model_bez_llm'`,
# wiec daja sie odsiac. TYPY_BEZ_LLM=0 cofa zapis bez redeploya.
TYPY_BEZ_LLM=1

# ============================================================
# BEZPIECZEŃSTWO / AUTH
# ============================================================
# Wygeneruj: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_jwt_secret_min_32_chars

# Konto administratora (fallback logowania gdy DB niedostępna)
FOOTSTATS_USER=admin
FOOTSTATS_PASSWORD_HASH=bcrypt_hash_hasla

# Shared secret endpointów /cron/* wołanych przez Cloud Scheduler.
CRON_SECRET=your_cron_shared_secret

# Token chroniący /metrics (bez niego endpoint zwraca 401).
METRICS_TOKEN=your_metrics_token

# CORS — URL frontendu
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Content-Security-Policy: 0 = tylko raportowanie (domyślnie), 1 = wymuszanie.
# Domyślnie raportowanie, bo CSP psująca GUI jest gorsza od jej braku — użytkownik
# widzi białą stronę, a przyczyna siedzi w nagłówku, nie w kodzie. Flaga pozwala
# przełączyć bez wdrażania nowego obrazu. Zmierzone 23.08 lokalnie przy CSP_ENFORCE=1:
# zero naruszeń na /, /preview, /app i /polityka-prywatnosci (bez widoków po zalogowaniu).
CSP_ENFORCE=0

# Baza URL frontendu w linkach mailowych (reset hasła). Bez tego reset nie działa.
FRONTEND_URL=http://localhost:5173

# ============================================================
# EMAIL (Resend)
# ============================================================
# mailer.py czyta OBIE pisownie. Kanoniczna jest WIELKIMI literami; wariant małymi
# to alias wsteczny (tak stoi w istniejącym .env) — nie usuwać bez migracji klucza.
RESEND_API_KEY=your_resend_key
# resend_api_key=your_resend_key
RESEND_FROM=onboarding@resend.dev

# ============================================================
# TELEGRAM (opcjonalny)
# ============================================================
# Utwórz bota: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
TELEGRAM_BOT_USERNAME=your_bot_username

# ============================================================
# SCRAPER LOGINY (Playwright — tylko lokalnie, nie w cloud draft)
# ============================================================
STS_LOGIN=your_email@example.com
STS_HASLO=your_sts_password
SUPERBET_LOGIN=your_email@example.com
SUPERBET_PASSWORD=your_superbet_password

# ============================================================
# OBSERWOWALNOŚĆ (opcjonalne)
# ============================================================
SENTRY_DSN=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=

# ============================================================
# BANKROLL / OPERATOR
# ============================================================
WEEKLY_DRAWDOWN_PCT=10
OPERATOR_ADMIN_USERNAME=admin
OPERATOR_SMOKE_TIMEOUT=
OPERATOR_STAWKA_A=
OPERATOR_STAWKA_B=

# Smoke-testy API operatora
SMOKE_JWT_SECRET=
SMOKE_TEST_PASS=
FOOTSTATS_PASSWORD=

# ============================================================
# ŚRODOWISKO / PRZEŁĄCZNIKI
# ============================================================
# "production" wyłącza /docs, /openapi i montowanie /mcp
ENV=development

# Tryb demo API (zwraca dane przykładowe zamiast prawdziwych)
DEMO_MODE=0

# Odblokowuje lokalne uruchomienie LIVE pipeline (guard scripts/hooks/guard_live_ops.py)
FOOTSTATS_ALLOW_LIVE=0

# Odświeżanie bazy zawodników w fazie final
FOOTSTATS_REFRESH_PLAYERS=0

# Świadome obejście guardu prod-DB w testach — TYLKO diagnostyka
# FOOTSTATS_ALLOW_PROD_DB=1

# ============================================================
# USUNIĘTE 2026-07-29 (audyt) — nie przywracać bez konsumenta w kodzie:
#   GOOGLE_API_KEY   — zero odczytów w src/ i scripts/
#   SECRET_KEY       — wymagany przez preflight/sanity_check i ustawiany w CI,
#                      ale ŻADEN kod produkcyjny go nie czyta (fałszywe poczucie
#                      bezpieczeństwa). Usunąć też ze skryptów i Secret Managera.
#   LOG_LEVEL        — w kodzie to stała w utils/logging.py, nie zmienna env
#   UPTIMEROBOT_API_KEY — zero odczytów
#   NEXT_PUBLIC_SUPABASE_URL / _PUBLISHABLE_KEY — pozostałość po Next.js,
#                      GUI jest na Vite (VITE_/import.meta.env)
# ============================================================
