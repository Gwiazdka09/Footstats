# Dockerfile.api — FastAPI server image (no Playwright)

# --- Stage 1: build React GUI (gui/dist) ---
FROM node:20-slim AS gui-build
WORKDIR /gui
COPY src/footstats/gui/package.json src/footstats/gui/package-lock.json ./
RUN npm ci --legacy-peer-deps
COPY src/footstats/gui ./
RUN npm run build

# --- Stage 2: FastAPI runtime ---
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

COPY pyproject.toml ./
COPY src ./src
COPY --from=gui-build /gui/dist ./src/footstats/gui/dist

# Dataset Poissona (32k meczów, 562 KB). Ten obraz serwuje NIE TYLKO API — chodzi na
# nim `/cron/draft`, czyli to co tworzy kupony System (nasze dane walidacyjne).
# Bez parquetu `load_cached()` zwraca None i draft robi cichy fallback na bzzoiro-ml
# zamiast Poisson-DC (potwierdzone dry-runem na prodzie 29.07: model_source=bzzoiro-ml).
# Wymaga negacji `!data/hist_cache/full_dataset.parquet` w .dockerignore — bez niej
# ten COPY wywala build ("not found", plik wycięty z kontekstu).
COPY data/hist_cache/full_dataset.parquet ./data/hist_cache/full_dataset.parquet

RUN uv pip install --system ".[api]" && mkdir -p /app/data

RUN addgroup --system app && adduser --system --ingroup app app \
    && chown -R app:app /app
USER app

EXPOSE 8000

CMD uvicorn footstats.api.main:app --host 0.0.0.0 --port ${PORT:-8000}
